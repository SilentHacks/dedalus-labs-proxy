# Required: your Dedalus Labs API key
# https://www.dedaluslabs.ai/dashboard/api-keys
DEDALUS_API_KEY=your-api-key-here

# Server binding (CLI flags override these)
HOST=localhost
PORT=8000
LOG_LEVEL=INFO

# Optional tuning
# REQUEST_TIMEOUT=300
# MAX_RETRIES=2
# STREAM_KEEPALIVE_INTERVAL=15
# TOOL_MAX_TOKENS=128000
# MAX_TOKENS=4096
# DEFAULT_TEMPERATURE=0.7

# Production hardening
# CORS_ORIGINS=https://app.example.com
# DISABLE_DOCS=true
# PROXY_API_KEYS=dev-key-1,dev-key-2

# Usage tracking (disabled by default)
# USAGE_TRACKING=true
# USAGE_LOG=true
# USAGE_HEADERS=true
# USAGE_SSE_METADATA=true
# USAGE_ADMIN_ENABLED=true
# USAGE_ADMIN_KEYS=admin-key-1,admin-key-2
# USAGE_STORE_MAX_RECORDS=1000
# USAGE_SESSION_TTL_SECONDS=86400
# USAGE_CHARS_PER_TOKEN=4
# USAGE_CONTEXT_LIMITS_JSON={"my/custom-model": 32000}
