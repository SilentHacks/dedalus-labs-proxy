# Required: your Dedalus Labs API key
# https://www.dedaluslabs.ai/dashboard/api-keys
DEDALUS_API_KEY=your-api-key-here

# Server binding (CLI flags override these)
HOST=localhost
PORT=8000
LOG_LEVEL=INFO

# Optional tuning
# REQUEST_TIMEOUT=300
# MAX_RETRIES=2
# STREAM_KEEPALIVE_INTERVAL=15
# TOOL_MAX_TOKENS=128000
# MAX_TOKENS=4096
# DEFAULT_TEMPERATURE=0.7

# Production hardening
# CORS_ORIGINS=https://app.example.com
# DISABLE_DOCS=true
